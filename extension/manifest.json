{
  "manifest_version": 3,
  "name": "My Phone — Preview Studio",
  "description": "Multi-project Chrome side panel for GitHub apps deployed to Vercel or another HTTPS host.",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "action": {"default_title": "Open My Phone Preview Studio"},
  "permissions": ["sidePanel", "storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "side_panel": {"default_path": "sidepanel.html"}
}
