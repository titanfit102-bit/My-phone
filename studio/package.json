{
  "name": "my-phone-expo-studio",
  "version": "0.4.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "export:web": "node scripts/export-web.mjs && node scripts/emit-build-info.mjs",
    "check:config": "node --test tests/*.test.mjs",
    "check:security-static": "node --test tests/static-security.test.mjs && node scripts/check-static-security.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.0",
    "expo": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "~19.2.0",
    "typescript": "~5.9.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
